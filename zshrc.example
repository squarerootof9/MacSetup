# Teach by osmosis: keep tools readable, discoverable, and one command away.

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

#Linux
alias lt='ls --human-readable --size -1 -S --classify'
alias mnt="mount | awk -F' ' '{ printf \"%s\t%s\n\",\$1,\$3; }' | column -t | egrep ^/dev/ | sort"
#Mac
#alias lt='du -sh * | sort -h'
#alias mnt='mount | grep -E ^/dev | column -t'

alias count='find . -type f | wc -l'

alias c='clear'                           # if you want even shorter than cl
alias q='exit'                            # if you want even shorter than xx
alias m='btop'                            # m for 'monitor'
alias s='cd ~/Downloads/MacSetup-main'    # <- quick path to there
alias x=extract

extract() {
  [[ $# -ge 1 ]] || { echo "usage: extract <archive> [...]" >&2; return 2; }

  local f out
  local -a cmd

  for f in "$@"; do
    [[ -f "$f" ]] || { echo "extract: not a file: $f" >&2; continue; }

    out="${f##*/}.extract"

    case "$f" in
      *.tar.bz2|*.tbz2) cmd=(tar -xjf "$f") ;;
      *.tar.gz|*.tgz)   cmd=(tar -xzf "$f") ;;
      *.tar.xz|*.txz)   cmd=(tar -xJf "$f") ;;
      *.tar.zst|*.tzst) cmd=(tar --zstd -xf "$f") ;;
      *.tar.lzma)       cmd=(tar --lzma -xf "$f") ;;
      *.tar)            cmd=(tar -xf "$f") ;;

      *.bz2)            cmd=(bunzip2 -- "$f") ;;
      *.gz)             cmd=(gunzip -- "$f") ;;
      *.xz)             cmd=(unxz -- "$f") ;;
      *.zst)            cmd=(unzstd -- "$f") ;;
      *.Z)              cmd=(uncompress -- "$f") ;;

      *.zip)            cmd=(unzip -q -- "$f") ;;
      *.7z)             cmd=(7z x -y -- "$f") ;;
      *.rar)            cmd=(unrar x -o+ -- "$f") ;;

      *.deb)            cmd=(dpkg-deb -x "$f" "$out") ;;
      *.rpm)            cmd=(bash -lc 'mkdir -p "$1" && rpm2cpio "$2" | (cd "$1" && cpio -idmu)' _ "$out" "$f") ;;

      *.AppImage|*.appimage)
                       cmd=(bash -lc 'mkdir -p "$1" && chmod +x "$2" && (cd "$1" && "$2" --appimage-extract >/dev/null)' _ "$out" "$f") ;;
      *.squashfs|*.sqsh) cmd=(unsquashfs "$f") ;;

      *) echo "extract: don't know how to extract: $f" >&2; continue ;;
    esac

    command -v "${cmd[1]}" >/dev/null 2>&1 || { echo "extract: missing tool: ${cmd[1]} (for $f)" >&2; continue; }
    "${cmd[@]}"
  done
}

# ---- git quick commands ----

# Safe “wrapper” so functions can pass args cleanly
g() { git "$@"; }

gs() { git status "$@"; } # short status (+ branch)
ga() {
	if [[ $# -eq 0 ]]; then
		git add -A
	else
		git add "$@" # ga file1 file2
	fi
}
gaa() { git add -A "$@"; }        # add all changes
gd() { git diff "$@"; }           # working tree diff
gds() { git diff --staged "$@"; } # staged diff
gl() { git log --oneline --decorate --graph --all "$@"; }
gb() { git branch "$@"; }
go() { git checkout "$@"; } # or use 'git switch' below
gpl() { git pull "$@"; }
gp() {
	if [[ $# -gt 0 ]]; then
		git push "$@"
		return
	fi
	local br
	br="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" || return 1
	git push -u origin "$br"
}
gm() { git merge "$@"; }

# Better commit: gc "message with spaces"
gc() {
	if [[ $# -lt 1 ]]; then
		echo "usage: gc <message>"
		return 1
	fi
	git commit -m "$*"
}

gcremove() {
	local branch_name="${1:-main}"

	git show-ref --verify --quiet "refs/heads/$branch_name" || {
		echo "Branch not found locally: $branch_name" >&2
		return 1
	}

	git fetch origin "$branch_name" || return 1
	git checkout "$branch_name" || return 1

	git branch "backup-${branch_name}-before-rewrite-$(date +%F_%H%M%S)" || return 1

	git reset --hard HEAD~1 || return 1
	git push --force-with-lease origin "$branch_name"
}

# Convenience commits
gca() { git commit --amend "$@"; }       # amend (add -m "msg" if you want)
gcan() { git commit --amend --no-edit; } # amend without changing message

# Create/switch branches (modern)
gsw() { git switch "$@"; }     # switch to branch
gswc() { git switch -c "$@"; } # create + switch

# Fetch + prune stale remotes
gf() { git fetch --all --prune "$@"; }

# Show last commit
g1() { git log -1 --stat "$@"; }

# Undo helpers (use with care)
gunstage() { git restore --staged "$@"; } # unstage paths
grestore() { git restore "$@"; }          # discard working-tree changes to paths

ghelp() {
	cat <<'EOF'

Git helpers
-----------

basics
  gs                 status
  ga <paths...>      add paths
  gaa                add all changes
  gc <message...>    commit with message (spaces ok)
  gp [remote branch] push (e.g., gp origin main)
  gpl [args]         pull
  gf                 fetch --all --prune

inspect
  gd [args]          diff
  gds [args]         diff --staged
  gl                 pretty log graph
  g1                 last commit

branches
  gb [args]          branch
  go <thing>         checkout (old)
  gsw <branch>       switch (new)
  gswc <branch>      create + switch

fixups
  gca [args]         commit --amend
  gcan               amend --no-edit
  gunstage <paths>   unstage
  grestore <paths>   discard working-tree changes

EOF
}

